# Environment Variables Template
# Copy this file to .env and configure for your environment

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django-command
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database (PostgreSQL — matches docker-compose db service on localhost:5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serveflow

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=serveflowai.business@gmail.com
EMAIL_HOST_PASSWORD=fjzdvkwizstozeag
DEFAULT_FROM_EMAIL=ServeFlow AI <noreply@serveflow.ai>

# For development (prints to console):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# WebSocket Channel Layer (Redis)
# For production, install Redis and configure:
REDIS_URL=redis://localhost:6379/0

# For development (InMemory - already configured in settings.py):
# No environment variable needed

# Google Gemini AI — required for real vision/text AI on the Django API.
# GEMINI_API_KEY=your-gemini-api-key-here
# Optional: GEMINI_MODEL_NAME must be gemini-3-flash-preview or gemini-3.1-pro-preview (defaults to flash).
# Optional: GEMINI_API_KEY_1 .. GEMINI_API_KEY_5 or GEMINI_API_KEYS (comma-separated)

# Vision fallback: placeholder analysis when Gemini is unavailable (default false).
# AI_VISION_ALLOW_SIMULATED_FALLBACK=false

# Static and Media Files
# STATIC_URL=/static/
# MEDIA_URL=/media/

# Auth rate limits & lockouts (DRF ScopedRateThrottle + cache lockout)
# RATE_AUTH_LOGIN=10/min
# RATE_AUTH_OTP=5/hour
# RATE_AUTH_OTP_EMAIL=3/hour
# RATE_AUTH_OTP_VERIFY=20/hour
# RATE_AUTH_REGISTER=10/hour
# RATE_AUTH_PASSWORD_RESET=5/hour
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_SECONDS=900
# AUTH_LOCKOUT_DURATION_SECONDS=900
# AUTH_MAX_BODY_BYTES=8192
# AUTH_MAX_PASSWORD_LENGTH=128
# OTP_EXPIRY_SECONDS=600
# OTP_MAX_ATTEMPTS=5
# OTP_RATE_LIMIT_PER_HOUR=3

# Security Settings (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY
